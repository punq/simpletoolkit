{
  "name": "simpletoolkit",
  "version": "0.1.0",
  "description": "Privacy-first, browser-based tools for PDFs, images, and data formatting. 100% client-side processing with zero uploads.",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/punq/simpletoolkit.git"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "ci": "npm run lint:ci && npm run typecheck && npm run test:coverage && npm run build",
    "lint:ci": "eslint --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "cross-env NODE_OPTIONS=--max-old-space-size=2048 jest",
    "test:watch": "cross-env NODE_OPTIONS=--max-old-space-size=2048 jest --watch",
    "test:coverage": "cross-env NODE_OPTIONS=--max-old-space-size=2048 jest --coverage",
    "postinstall": "node scripts/copy-pdf-worker.js"
  },
  "dependencies": {
    "lucide-react": "^0.554.0",
    "next": "16.0.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.4.394",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.0.1",
    "jest": "^30.2.0",
    "jest-axe": "^10.0.0",
    "jest-environment-jsdom": "^30.2.0",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "typescript": "^5"
  },
  "overrides": {
    "glob": "7.2.3",
    "js-yaml": "^4.1.1"
  }
}
